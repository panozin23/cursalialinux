libreoffice-l10n-es
hunspell-es

# ===== Centro de Bienvenida =====
yad
papirus-icon-theme

# --- para instalar VSCodium via hook ---
wget
gnupg
ca-certificates

# --- rendimiento ---
zram-tools
preload

# ===== SEGURIDAD =====
# Cortafuegos: se activa solo en el primer arranque (hook 0400).
# plasma-firewall lo integra en Preferencias del Sistema de KDE.
ufw
plasma-firewall
# Sin rsyslog, ufw solo escribe al journal y la pestaña
# "Registro" de la interfaz gráfica sale siempre vacía.
rsyslog

# Parches de seguridad automáticos (configurado en el hook 0410).
unattended-upgrades

# ===== ARRANQUE SEGURO (Secure Boot) =====
# Sin estos, los equipos con Arranque Seguro activado —la mayoría de
# fábrica— avisan "no es de confianza" al arrancar la ISO, y muchos
# se niegan del todo. Con ellos, cursalialinux arranca sin que nadie
# tenga que entrar a la BIOS a desactivar nada.
shim-signed
grub-efi-amd64-signed
mokutil
