# ===== cursalialinux Moderna (KDE Plasma) =====

# --- Núcleo del sistema en vivo ---
linux-image-amd64
live-boot
live-config
live-config-systemd

# --- Escritorio KDE Plasma ---
kde-plasma-desktop
sddm
plasma-nm
plasma-workspace-wallpapers
dolphin
konsole
kate
ark
gwenview
okular
kcalc
kde-spectacle

# --- Cartera de contraseñas ---
# Sin libpam-kwallet5 la cartera no se abre sola al iniciar sesión y
# cualquier programa que guarde una clave (VS Code, el correo, el
# navegador) hace saltar una ventana pidiendo contraseña.
# kwalletmanager permite verla y cambiarle la contraseña.
libpam-kwallet5
kwalletmanager

# --- Instalador gráfico ---
calamares
calamares-settings-debian

# --- Firmware / drivers ---
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
firmware-atheros

# --- Arranque ---
plymouth
plymouth-themes

