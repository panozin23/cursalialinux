#!/bin/bash
# ================================================================
#  Centro de Bienvenida — cursalialinux  (catálogo completo)
#  Instalado = abre directo · Del catálogo = "📥 instalar" (bajo demanda)
#  Enfocado en desarrollo web + creación de contenido.
# ================================================================
SELF="/usr/local/bin/centro-cursalialinux"
LOGO="/usr/share/pixmaps/cursalialinux.png"

declare -A CMD NOM ICO KIND
# kind: apt | root | term | own | url
reg(){ CMD["$1"]="$2"; NOM["$1"]="$3"; ICO["$1"]="${4:-application-x-executable}"; KIND["$1"]="${5:-apt}"; }

# --- Web ---
reg codium "codium" "VSCodium — editor de código" "text-editor"
reg xfce4-terminal "xfce4-terminal" "Terminal de desarrollo" "utilities-terminal"
reg firefox-esr "firefox-esr" "Firefox — navegador" "web-browser"
reg filezilla "filezilla" "FileZilla — FTP/SFTP" "network-server"
reg bluefish "bluefish" "Bluefish — editor web (HTML/PHP)" "text-html"
reg git-cola "git-cola" "Git-cola — control de versiones" "applications-development"
reg sqlitebrowser "sqlitebrowser" "SQLite Browser — bases de datos" "accessories-database"
reg meld "meld" "Meld — comparar código" "text-x-generic"
reg chromium "chromium" "Chromium — navegador de pruebas" "web-browser"
# --- Video ---
reg shotcut "shotcut" "Shotcut — editor de video" "multimedia-video-player"
reg vlc "vlc" "VLC — reproductor" "multimedia-video-player"
reg cheese "cheese" "Cheese — cámara web" "camera-web"
reg aegisub "aegisub" "🎤 Aegisub — subtítulos y karaoke" "text-x-generic"
reg subtitleeditor "subtitleeditor" "🎤 Subtitle Editor — subtítulos" "text-x-generic"
reg simplescreenrecorder "simplescreenrecorder" "Grabar la pantalla" "camera-video"
reg handbrake "ghb" "HandBrake — convertir video" "media-optical"
reg kdenlive "kdenlive" "Kdenlive — editor profesional" "applications-multimedia"
reg openshot-qt "openshot-qt" "OpenShot — editor fácil" "applications-multimedia"
reg obs-studio "obs" "OBS Studio — grabar y transmitir" "camera-video"
reg performous "performous" "🎤 Performous — cantar karaoke" "applications-games"
# --- Imágenes ---
reg imgbuscar "cursalia-imagenes-libres" "🔎 Buscar imágenes libres (uso comercial)" "image-x-generic" own
reg imgguia "cursalia-imagenes-libres guia" "📜 Guía de licencias de imágenes" "text-x-generic" own
reg url-openverse "https://openverse.org" "Openverse — imágenes libres (web)" "web-browser" url
reg url-pixabay "https://pixabay.com/es/" "Pixabay — imágenes gratis (web)" "web-browser" url
reg url-pexels "https://www.pexels.com/es-es/" "Pexels — fotos gratis (web)" "web-browser" url
reg url-unsplash "https://unsplash.com" "Unsplash — fotos gratis (web)" "web-browser" url
reg gimp "gimp" "GIMP — edición de imágenes" "image-x-generic"
reg inkscape "inkscape" "Inkscape — vectores y logos" "image-svg+xml"
reg krita "krita" "Krita — dibujo digital" "applications-graphics"
reg darktable "darktable" "Darktable — fotografía RAW" "camera-photo"
reg rawtherapee "rawtherapee" "RawTherapee — revelado RAW" "camera-photo"
reg scribus "scribus" "Scribus — maquetación (revistas/PDF)" "x-office-document"
reg digikam "digikam" "digiKam — organizar fotos" "image-x-generic"
reg blender "blender" "Blender — 3D y animación" "applications-graphics"
reg trimage "trimage" "Trimage — comprimir PNG/JPG (web)" "image-x-generic"
reg converseen "converseen" "Converseen — lote: convertir/redimensionar" "image-x-generic"
reg gthumb "gthumb" "gThumb — ver y procesar por lotes" "image-x-generic"
reg pngquant "pngquant" "pngquant — comprimir PNG (comando)" "image-x-generic" term
reg jpegoptim "jpegoptim" "jpegoptim — optimizar JPG (comando)" "image-x-generic" term
reg webp "cwebp" "WebP — convertir a WebP (comando)" "image-x-generic" term
# --- Audio ---
reg audacity "audacity" "Audacity — editor de audio" "audio-x-generic"
reg lmms "lmms" "LMMS — producción musical" "audio-x-generic"
reg hydrogen "hydrogen" "Hydrogen — caja de ritmos" "audio-x-generic"
reg musescore3 "mscore3" "MuseScore — partituras" "audio-x-generic"
reg mixxx "mixxx" "Mixxx — mezcla DJ" "audio-x-generic"
reg rosegarden "rosegarden" "Rosegarden — secuenciador MIDI" "audio-x-generic"
reg kid3 "kid3" "Kid3 — etiquetas de MP3" "audio-x-generic"
reg ardour "ardour" "Ardour — estudio de grabación pro" "audio-x-generic"
# --- Oficina ---
reg libreoffice-writer "libreoffice --writer" "Writer — documentos (Word)" "x-office-document"
reg libreoffice-calc "libreoffice --calc" "Calc — hojas de cálculo (Excel)" "x-office-spreadsheet"
reg libreoffice-impress "libreoffice --impress" "Impress — presentaciones (PowerPoint)" "x-office-presentation"
reg libreoffice-draw "libreoffice --draw" "Draw — dibujo y diagramas" "x-office-drawing"
reg libreoffice-base "libreoffice --base" "Base — bases de datos" "accessories-database"
reg evince "evince" "Evince — leer PDF" "application-pdf"
reg xournalpp "xournalpp" "Xournal++ — anotar PDF / apuntes" "application-pdf"
reg calibre "calibre" "Calibre — libros electrónicos" "accessories-dictionary"
# --- Internet ---
reg qbittorrent "qbittorrent" "qBittorrent — descargas" "applications-internet"
reg thunderbird "thunderbird" "Thunderbird — correo electrónico" "mail-message-new"
# --- Seguridad ---
reg keepassxc "keepassxc" "🔑 KeePassXC — gestor de contraseñas" "dialog-password"
reg gufw "gufw" "🔥 Cortafuegos (Firewall)" "security-high" root
reg clamtk "clamtk" "🦠 ClamTk — antivirus" "security-medium"
reg wireshark "wireshark" "Wireshark — analizar red" "network-wired"
reg nmap "nmap" "nmap — escanear puertos/red" "network-workgroup" term
reg nikto "nikto" "Nikto — escáner de webs" "security-high" term
reg sqlmap "sqlmap" "sqlmap — probar inyección SQL" "security-high" term
reg wapiti "wapiti" "Wapiti — vulnerabilidades web" "security-high" term
reg whatweb "whatweb" "WhatWeb — tecnologías de una web" "network-workgroup" term
reg dirb "dirb" "dirb — rutas ocultas de una web" "security-high" term
reg lynis "lynis" "Lynis — auditoría de seguridad" "security-medium" term
reg url-zap "https://www.zaproxy.org/download/" "OWASP ZAP — auditar webs (descargar)" "security-high" url
reg url-burp "https://portswigger.net/burp/communitydownload" "Burp Suite Community (descargar)" "security-high" url
# --- Sistema ---
reg gparted "gparted" "GParted — particiones de disco" "drive-harddisk" root
reg timeshift "timeshift-gtk" "Timeshift — respaldos del sistema" "document-save" root
reg thunar "thunar" "Gestor de archivos" "system-file-manager"
reg xfce4-taskmanager "xfce4-taskmanager" "Monitor del sistema" "utilities-system-monitor"

WEB="codium xfce4-terminal firefox-esr filezilla bluefish git-cola sqlitebrowser meld chromium"
VIDEO="shotcut vlc cheese aegisub subtitleeditor simplescreenrecorder handbrake kdenlive openshot-qt obs-studio performous"
IMAGEN="imgbuscar imgguia url-openverse url-pixabay url-pexels url-unsplash gimp inkscape krita darktable rawtherapee scribus digikam blender trimage converseen gthumb pngquant jpegoptim webp"
AUDIO="audacity lmms hydrogen musescore3 mixxx rosegarden kid3 ardour"
OFICINA="libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-draw libreoffice-base evince xournalpp calibre"
INTERNET="firefox-esr qbittorrent chromium thunderbird filezilla"
SEGURIDAD="keepassxc gufw clamtk wireshark nmap nikto sqlmap wapiti whatweb dirb lynis url-zap url-burp"

instalar_pkg(){
  local pkg="$1" nom="$2"
  xfce4-terminal --title="Instalar ${nom}" --hold -e "bash -c '
    echo \"=== Instalar: ${nom}  (${pkg}) ===\"
    echo \"Necesita conexion a internet. Se te pedira tu contrasena.\"; echo
    pkexec sh -c \"apt-get update && apt-get install -y ${pkg}\"
    echo; echo \"Listo. Abrelo de nuevo desde su Studio. Puedes cerrar esta ventana.\"
  '" &
}

abrir(){
  local pkg="$1" k="${KIND[$1]}" cmd="${CMD[$1]}"
  case "$k" in
    own) setsid $cmd >/dev/null 2>&1 & ;;
    url) setsid firefox-esr "$cmd" >/dev/null 2>&1 & ;;
    *)
      if dpkg -s "$pkg" >/dev/null 2>&1; then
        case "$k" in
          root) setsid pkexec $cmd >/dev/null 2>&1 & ;;
          term) setsid xfce4-terminal --title="${NOM[$pkg]}" -e "bash -c \"echo '${NOM[$pkg]} — listo. Comando: $cmd'; echo; exec bash\"" >/dev/null 2>&1 & ;;
          *) setsid $cmd >/dev/null 2>&1 & ;;
        esac
      else
        instalar_pkg "$pkg" "${NOM[$pkg]}"
      fi ;;
  esac
}

studio(){
  local titulo="$1" ico_t="$2" desc="$3"; shift 3
  local args=(--title="$titulo — cursalialinux" --center --width=620 --height=660
    --window-icon="$LOGO" --image="$LOGO" --image-on-top
    --text="<big><b>${ico_t}  ${titulo}</b></big>\n${desc}" --form --columns=1)
  local pkg lbl k
  for pkg in "$@"; do
    k="${KIND[$pkg]}"
    if [ "$k" = "own" ] || [ "$k" = "url" ]; then lbl="${NOM[$pkg]}"
    elif dpkg -s "$pkg" >/dev/null 2>&1; then lbl="${NOM[$pkg]}"
    else lbl="📥 ${NOM[$pkg]}  —  instalar"; fi
    args+=(--field="${lbl}!${ICO[$pkg]}:fbtn" "bash -c '$SELF abrir $pkg &'")
  done
  args+=(--button="⬅ Volver:bash -c '$SELF &'" --button="Cerrar:1")
  yad "${args[@]}"
}

estudio_sistema(){
  local args=(--title="Sistema — cursalialinux" --center --width=600 --height=460
    --window-icon="$LOGO" --image="$LOGO" --image-on-top
    --text="<big><b>🛠️  Sistema</b></big>\nMantenimiento, limpieza y utilidades" --form --columns=1
    --field="🧹  Limpieza cursalialinux — menú completo!edit-clear:fbtn" "bash -c '/usr/local/bin/cursalia-limpieza &'")
  local pkg lbl
  for pkg in gparted timeshift thunar xfce4-taskmanager; do
    if dpkg -s "$pkg" >/dev/null 2>&1; then lbl="${NOM[$pkg]}"; else lbl="📥 ${NOM[$pkg]}  —  instalar"; fi
    args+=(--field="${lbl}!${ICO[$pkg]}:fbtn" "bash -c '$SELF abrir $pkg &'")
  done
  args+=(--button="⬅ Volver:bash -c '$SELF &'" --button="Cerrar:1")
  yad "${args[@]}"
}

menu_principal(){
  yad --title="Centro cursalialinux" --center --width=660 --height=680 \
    --window-icon="$LOGO" --image="$LOGO" --image-on-top \
    --text="<big><b>Bienvenido a cursalialinux</b></big>
Tu sistema para <b>desarrollo web</b> y <b>creación de contenido</b>.

Elige un Estudio  (las apps del catálogo se instalan con un clic):" \
    --form --columns=1 \
    --field="💻   Web Studio — desarrollo web!applications-development:fbtn"          "bash -c '$SELF web &'" \
    --field="🎬   Video Studio — edición, grabación, karaoke!applications-multimedia:fbtn" "bash -c '$SELF video &'" \
    --field="🖼️   Imágenes y Diseño — gráficos, fotos, imágenes libres!applications-graphics:fbtn" "bash -c '$SELF imagenes &'" \
    --field="🎙️   Audio Studio — música y podcast!audio-x-generic:fbtn"             "bash -c '$SELF audio &'" \
    --field="🛡️   Seguridad — proteger y auditar webs!security-high:fbtn"           "bash -c '$SELF seguridad &'" \
    --field="📄   Oficina — Word, Excel, PowerPoint!applications-office:fbtn"         "bash -c '$SELF oficina &'" \
    --field="🌐   Internet — navegar, correo, descargas!applications-internet:fbtn"   "bash -c '$SELF internet &'" \
    --field="🛠️   Sistema — limpieza y mantenimiento!applications-system:fbtn"        "bash -c '$SELF sistema &'" \
    --button="Cerrar:1"
}

case "$1" in
  web)      studio "Web Studio" "💻" "Desarrollo web" $WEB ;;
  video)    studio "Video Studio" "🎬" "Edición, grabación y karaoke" $VIDEO ;;
  imagenes) studio "Imágenes y Diseño" "🖼️" "Gráficos, fotos, imágenes libres y optimización web" $IMAGEN ;;
  audio)    studio "Audio Studio" "🎙️" "Música, podcast y grabación" $AUDIO ;;
  seguridad) studio "Seguridad" "🛡️" "Protege tu equipo y audita la seguridad de TUS webs" $SEGURIDAD ;;
  oficina)  studio "Oficina" "📄" "Compatible con Word, Excel y PowerPoint" $OFICINA ;;
  internet) studio "Internet" "🌐" "Navegar, correo y descargas" $INTERNET ;;
  sistema)  estudio_sistema ;;
  abrir)    abrir "$2" ;;
  instalar) instalar_pkg "$2" "$3" ;;
  *)        menu_principal ;;
esac
