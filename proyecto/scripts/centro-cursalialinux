instalar_pkg(){
  local pkg="$1" nom="$2"
  xfce4-terminal --title="Instalar ${nom}" --hold -e "bash -c '
    echo \"=== Instalar: ${nom}  (${pkg}) ===\"
    echo \"Necesita conexion a internet. Se te pedira tu contrasena.\"; echo
    if pkexec sh -c \"apt-get update && apt-get install -y ${pkg}\"; then
      echo; echo \"Instalado. Abriendo ${nom}...\"; sleep 1
      setsid $SELF abrir ${pkg} >/dev/null 2>&1 &
    else
      echo; echo \"No se pudo instalar. Revisa tu internet e intenta de nuevo.\"
    fi
    echo; echo \"Puedes cerrar esta ventana.\"
  '" &
}

lanzar_pkg(){
  # abre una app instalada por su PROPIO acceso directo (.desktop): maneja la ruta,
  # el nombre real del binario y la auto-elevacion a root (gparted, etc.)
  local pkg="$1" cmd="$2" d id
  d=$(dpkg -L "$pkg" 2>/dev/null | grep -m1 "/usr/share/applications/.*\\.desktop$")
  if [ -n "$d" ]; then id=$(basename "$d" .desktop); setsid gtk-launch "$id" >/dev/null 2>&1 &
  else setsid $cmd >/dev/null 2>&1 & fi
}
abrir(){
  local pkg="$1" k="${KIND[$1]}" cmd="${CMD[$1]}"
  case "$k" in
    own) setsid $cmd >/dev/null 2>&1 & ;;
    url) setsid firefox-esr "$cmd" >/dev/null 2>&1 & ;;
    *)
      if dpkg -s "$pkg" >/dev/null 2>&1; then
        case "$k" in
          term) setsid xfce4-terminal --title="${NOM[$pkg]}" -e "bash -c \"echo '${NOM[$pkg]} — listo. Comando: $cmd'; echo; exec bash\"" >/dev/null 2>&1 & ;;
          *) lanzar_pkg "$pkg" "$cmd" ;;
        esac
      else
        instalar_pkg "$pkg" "${NOM[$pkg]}"
      fi ;;
  esac
}

# Ventana única: cierra cualquier ventana del Centro antes de abrir otra
solo_una(){ pkill -f "class=cursaliacentro" 2>/dev/null; sleep 0.15; }

studio(){
  solo_una
  local titulo="$1" ico_t="$2" desc="$3"; shift 3
  local n=$# cols=1 w=640
  local SH=$(xrandr 2>/dev/null | awk '/\*/{print $1; exit}' | cut -dx -f2)
  [ -z "$SH" ] && SH=768
  local maxH=$(( SH - 110 )); [ "$maxH" -lt 460 ] && maxH=460
  if [ $(( n * 44 + 210 )) -gt "$maxH" ]; then cols=2; w=960; fi
  local rows=$(( (n + cols - 1) / cols ))
  local h=$(( rows * 44 + 210 )); [ "$h" -gt "$maxH" ] && h=$maxH
  local args=(--class=cursaliacentro $GTKRC --borders=14 --title="$titulo — cursalialinux" --center --width=$w --height=$h
    --window-icon="$LOGO" --image="$LOGO_CAB" --image-on-top
    --text="<big><b>${ico_t}  ${titulo}</b></big>\n${desc}" --form --columns=$cols)
  local pkg lbl k
  for pkg in "$@"; do
    k="${KIND[$pkg]}"
    if [ "$k" = "own" ] || [ "$k" = "url" ]; then lbl="${NOM[$pkg]}"
    elif dpkg -s "$pkg" >/dev/null 2>&1; then lbl="${NOM[$pkg]}"
    else lbl="📥 ${NOM[$pkg]}  —  instalar"; fi
    args+=(--field="${lbl}!${ICO[$pkg]}:fbtn" "bash -c '$SELF abrir $pkg &'")
  done
  args+=(--button="⬅ Volver:bash -c '$SELF &'" --button="Cerrar:1")
  yad "${args[@]}"
}

estudio_sistema(){
  solo_una
  local SH=$(xrandr 2>/dev/null | awk '/\*/{print $1; exit}' | cut -dx -f2); [ -z "$SH" ] && SH=768
  local maxH=$(( SH - 110 )); [ "$maxH" -lt 460 ] && maxH=460
  local scols=1 sw=640; [ 738 -gt "$maxH" ] && { scols=2; sw=960; }
  local sh=$(( ((12 + scols - 1)/scols) * 44 + 240 )); [ "$sh" -gt "$maxH" ] && sh=$maxH
  local args=(--class=cursaliacentro $GTKRC --borders=14 --title="Sistema — cursalialinux" --center --width=$sw --height=$sh
    --window-icon="$LOGO" --image="$LOGO_CAB" --image-on-top
    --text="<big><b>🛠️  Sistema y Configuración</b></big>\nAjustes, mantenimiento y utilidades" --form --columns=$scols
    --field="⚙️   Configuración del sistema (todos los ajustes)!preferences-desktop:fbtn" "bash -c 'systemsettings &'"
    --field="🔄  Actualizar cursalialinux!system-software-update:fbtn" "bash -c '/usr/local/bin/cursalia-actualizar &'"
    --field="🕐  Fecha y hora!preferences-system-time:fbtn" "bash -c '/usr/local/bin/cursalia-fechahora &'"
    --field="🌐  Red / WiFi!network-wireless:fbtn" "bash -c 'nm-connection-editor &'"
    --field="🖨️   Impresoras!printer:fbtn" "bash -c 'system-config-printer &'"
    --field="📶  Bluetooth!bluetooth:fbtn" "bash -c 'blueman-manager &'"
    --field="👤  Usuarios (nombre y foto)!system-users:fbtn" "bash -c 'mugshot &'"
    --field="🧹  Limpieza cursalialinux — menú completo!edit-clear:fbtn" "bash -c '/usr/local/bin/cursalia-limpieza &'")
  local pkg lbl
  for pkg in gparted timeshift thunar xfce4-taskmanager; do
    if dpkg -s "$pkg" >/dev/null 2>&1; then lbl="${NOM[$pkg]}"; else lbl="📥 ${NOM[$pkg]}  —  instalar"; fi
    args+=(--field="${lbl}!${ICO[$pkg]}:fbtn" "bash -c '$SELF abrir $pkg &'")
  done
  args+=(--button="⬅ Volver:bash -c '$SELF &'" --button="Cerrar:1")
  yad "${args[@]}"
}

