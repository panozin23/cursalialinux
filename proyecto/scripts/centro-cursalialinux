#!/bin/bash

# yad en Wayland avisa "gdk_x11_window_get_xid: assertion failed" porque pide
# un identificador de ventana de X11 que ahí no existe. No rompe nada, pero
# ensucia la terminal. Pasando por XWayland la llamada es válida y calla.
export GDK_BACKEND=x11
# ================================================================
#  Centro de Bienvenida — cursalialinux  (catálogo completo)
#  Instalado = abre directo · Del catálogo = "📥 instalar" (bajo demanda)
#  Enfocado en desarrollo web + creación de contenido.
# ================================================================
# Ruta propia: así funciona igual en /usr/bin (paquete) o /usr/local/bin (manual)
SELF="$(readlink -f "$0")"
LOGO="/usr/share/pixmaps/cursalialinux.png"

# Logo reducido para la cabecera de las ventanas. El de 256 px ocupaba casi
# la mitad del alto y dejaba las barras de Estudios apretadas abajo.
# Si no está el pequeño, se usa el grande y todo sigue funcionando.
CSS_CENTRO="/usr/share/cursalialinux/centro.css"
[ -f "$CSS_CENTRO" ] || CSS_CENTRO="$HOME/PROYECTOS-CURSALIA/cursalialinux/marca/centro.css"
GTKRC=""; [ -f "$CSS_CENTRO" ] && GTKRC="--gtkrc=$CSS_CENTRO"

LOGO_CAB="/usr/share/pixmaps/cursalialinux-96.png"
[ -f "$LOGO_CAB" ] || LOGO_CAB="$LOGO"
# incluir carpetas de administrador para encontrar herramientas como gparted (/usr/sbin)
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

declare -A CMD NOM ICO KIND
# kind: apt | root | term | own | url
reg(){ CMD["$1"]="$2"; NOM["$1"]="$3"; ICO["$1"]="${4:-application-x-executable}"; KIND["$1"]="${5:-apt}"; }

