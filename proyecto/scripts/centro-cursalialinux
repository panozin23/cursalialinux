estudio_windows(){
  solo_una
  local MH=$(xrandr 2>/dev/null | awk '/\*/{print $1; exit}' | cut -dx -f2); [ -z "$MH" ] && MH=768
  local mh=$(( MH - 110 )); [ "$mh" -gt 700 ] && mh=700; [ "$mh" -lt 480 ] && mh=480

  # Estado real, para que cada paso diga lo que corresponde
  local paso2 paso3 ico2 ico3 resumen paso_iso ico_iso hay_iso
  if command -v virt-manager >/dev/null 2>&1 && command -v virt-viewer >/dev/null 2>&1; then
    paso2="2️⃣   Herramientas instaladas  —  volver a comprobar"
    ico2="emblem-default"
    local n=0
    command -v virsh >/dev/null 2>&1 && n=$(virsh -c qemu:///system list --all --name 2>/dev/null | grep -c .)
    # ¿Hay ya una imagen de Windows colocada?
    local hay_iso=0
    for f in /var/lib/libvirt/images/*.iso; do
      case "$(basename "$f" 2>/dev/null)" in virtio*) continue ;; esac
      [ -r "$f" ] && { hay_iso=1; break; }
    done

    if [ "$hay_iso" -eq 1 ]; then
      paso_iso="3️⃣   Imagen de Windows lista  —  conseguir otra"
      ico_iso="emblem-default"
    else
      paso_iso="3️⃣   Conseguir la imagen de Windows  ←  <b>te toca esto</b>"
      ico_iso="folder-download"
    fi

    if [ "${n:-0}" -gt 0 ]; then
      paso3="4️⃣   Tienes $n máquina(s)  —  crear otra"
      ico3="emblem-default"
      resumen="Todo listo. Abre Windows desde el menú de aplicaciones."
    elif [ "$hay_iso" -eq 1 ]; then
      paso3="4️⃣   Crear tu máquina de Windows  ←  <b>te toca esto</b>"
      ico3="list-add"
      resumen="Imagen lista. Solo falta crear la máquina."
    else
      paso3="4️⃣   Crear tu máquina de Windows"
      ico3="list-add"
      resumen="Herramientas listas. Falta la imagen de Windows."
    fi
  else
    paso2="2️⃣   Instalar las herramientas  ←  <b>te toca esto</b>"
    ico2="system-software-install"
    paso_iso="3️⃣   Conseguir la imagen de Windows"
    ico_iso="folder-download"
    paso3="4️⃣   Crear tu máquina de Windows"
    ico3="list-add"
    resumen="Empieza por comprobar si tu equipo puede."
  fi

  yad --class=cursaliacentro $GTKRC --borders=14 --title="Windows Studio — cursalialinux" \
    --center --width=680 --height=$mh --window-icon="$LOGO" \
    --image="$LOGO_CAB" --image-on-top \
    --text="<big><b>🪟  Windows Studio</b></big>
Ejecuta programas de Windows <b>dentro</b> de cursalialinux, en una ventana.
Sin reiniciar, sin repartir el disco, sin dejar Linux.

<i>$resumen</i>" \
    --form --columns=1 \
    --field="1️⃣   ¿Puede mi equipo?  —  comprobar sin instalar nada!dialog-question:fbtn" \
        "bash -c 'x-terminal-emulator -e bash -c \"virt-inspeccionar.sh; echo; read -p \\\"Pulsa Enter para cerrar\\\"\" &'" \
    --field="$paso2!$ico2:fbtn" \
        "bash -c 'x-terminal-emulator -e bash -c \"sudo virt-instalar.sh; echo; read -p \\\"Pulsa Enter para cerrar\\\"\" &'" \
    --field="$paso_iso!$ico_iso:fbtn" \
        "bash -c 'cursalia-windows-iso.sh &'" \
    --field="$paso3!$ico3:fbtn" \
        "bash -c 'x-terminal-emulator -e bash -c \"sudo virt-crear-windows.sh; echo; read -p \\\"Pulsa Enter para cerrar\\\"\" &'" \
    --field="🖥️   Abrir Windows!distributor-logo-windows:fbtn"                    "bash -c 'cursalia-windows.sh &'" \
    --field="🎛️   Panel: internet, archivos, instantáneas!preferences-system-network:fbtn" \
        "bash -c 'cursalia-windows-control.sh &'" \
    --field="📘   Guía completa paso a paso!text-x-generic:fbtn" \
        "bash -c 'xdg-open /usr/share/doc/cursalialinux/GUIA-WINDOWS.md &'" \
    --field="⚖️   Licencias y responsabilidad  —  <b>léelo antes</b>!text-x-generic:fbtn" \
        "bash -c 'xdg-open /usr/share/doc/cursalialinux/LICENCIAS-WINDOWS.md &'" \
    --field="🛡️   Proteger un Windows sin soporte (7, 8.1, 10)!security-high:fbtn" \
        "bash -c 'xdg-open /usr/share/doc/cursalialinux/SEGURIDAD-WINDOWS.md &'" \
    --button="⬅ Volver:bash -c '$SELF &'" \
    --button="Cerrar:1"
}

menu_principal(){
  solo_una
  # El alto se calcula a partir de CUÁNTOS Estudios hay, no de la pantalla.
  # Antes estaba fijado para nueve y al quedar cinco sobraba media ventana
  # vacía, con el botón Cerrar flotando en un desierto gris.
  local n=6
  local mh=$(( 205 + n * 46 ))
  local MH=$(xrandr 2>/dev/null | awk '/\*/{print $1; exit}' | cut -dx -f2); [ -z "$MH" ] && MH=768
  local tope=$(( MH - 110 )); [ "$mh" -gt "$tope" ] && mh=$tope

  # Un solo icono por fila: el del tema. Los emojis se quitaron del texto
  # porque se dibujaban ADEMÁS del icono y parecían un error.
  yad --class=cursaliacentro $GTKRC --borders=14 --title="Centro cursalialinux" --center --width=660 --height=$mh \
    --window-icon="$LOGO" --image="$LOGO_CAB" --image-on-top --align=left \
    --text="<span size=\"xx-large\"><b>Bienvenido a cursalialinux</b></span>
Tu sistema para <b>desarrollo web</b> y <b>creación de contenido</b>.
" \
    --form --columns=1 \
    --field="Windows Studio — trabaja con tus programas de Windows!distributor-logo-windows:fbtn"        "bash -c '$SELF windows &'" \
    --field="Desarrollo Web — Laravel, WordPress, editores, SEO!text-html:fbtn" "bash -c '$SELF web &'" \
    --field="Video Studio — edición, grabación, karaoke!applications-multimedia:fbtn" "bash -c '$SELF video &'" \
    --field="Imágenes y Diseño — gráficos, fotos, imágenes libres!applications-graphics:fbtn" "bash -c '$SELF imagenes &'" \
    --field="Utilitarios — audio, oficina, internet, sistema!applications-utilities:fbtn" "bash -c '$SELF utilitarios &'" \
    --field="Acerca de — créditos y licencia libre!help-about:fbtn" "bash -c '$SELF acerca &'" \
    --button="Cerrar:1"
}

case "$1" in
  windows)     estudio_windows ;;
  utilitarios) estudio_utilitarios ;;
  acerca)      acerca_de ;;
  web)      studio "Desarrollo Web" "💻" "Crear proyectos (Laravel, WordPress), editores, bases de datos y SEO" $WEB ;;
  video)    studio "Video Studio" "🎬" "Edición, grabación y karaoke" $VIDEO ;;
  imagenes) studio "Imágenes y Diseño" "🖼️" "Gráficos, fotos, imágenes libres y optimización web" $IMAGEN ;;
  audio)    studio "Audio Studio" "🎙️" "Música, podcast y grabación" $AUDIO ;;
  seguridad) studio "Seguridad" "🛡️" "Protege tu equipo y audita la seguridad de TUS webs" $SEGURIDAD ;;
  oficina)  studio "Oficina" "📄" "Compatible con Word, Excel y PowerPoint" $OFICINA ;;
  internet) studio "Internet" "🌐" "Navegar, correo y descargas" $INTERNET ;;
  sistema)  estudio_sistema ;;
  abrir)    abrir "$2" ;;
  instalar) instalar_pkg "$2" "$3" ;;
  *)        menu_principal ;;
esac
